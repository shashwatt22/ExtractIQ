# Copy to .env and adjust as needed.

# Where uploads / results / vector store live
DOCINTEL_DATA_DIR=./data

# SQLite database URL
DOCINTEL_DATABASE_URL=sqlite:///./data/docintel.db

# Enable/disable heavy model extractors (auto-detected if deps missing)
DOCINTEL_ENABLE_LAYOUTLM=true
DOCINTEL_ENABLE_DONUT=true
DOCINTEL_ENABLE_OCR=true

# HuggingFace model checkpoints
DOCINTEL_LAYOUTLM_MODEL=nielsr/layoutlmv3-finetuned-funsd
DOCINTEL_DONUT_MODEL=naver-clova-ix/donut-base-finetuned-docvqa

# Optional: LLM answer synthesis for the RAG query endpoint.
# Without a key the system falls back to extractive answers.
# ANTHROPIC_API_KEY=
DOCINTEL_LLM_MODEL=claude-opus-4-8
